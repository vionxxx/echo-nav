{
    "manifest_version": 3,
    "name": "EchoNav",
    "version": "1.0",
    "description": "A Chrome extension that uses built-in AI to generate a dynamic, multi-level hierarchy outline from AI conversation histories.",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": ["storage", "tts", "activeTab", "scripting"],
    "host_permissions": [
        "https://chatgpt.com/*"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
         "matches": [
          "https://chatgpt.com/*"
        ],
        "js": ["content.js"],
        "css": ["sidepanel/sidepanel.css"]
      }
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "sidepanel/sidepanel.html",
          "icons/icon128.png"
        ],
        "matches": ["https://chatgpt.com/*"]
      }
    ],
    "action": {
      "default_title": "Toggle EchoNav",
      "default_icon": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png"
      }
    }
  }
  