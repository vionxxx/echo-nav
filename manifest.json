{
    "manifest_version": 3,
    "name": "EchoNav",
    "version": "1.0",
    "description": "A Chrome extension that uses built-in AI to generate a dynamic, multi-level hierarchy outline from AI conversation histories.",
    "permissions": ["storage", "tts", "activeTab", "scripting"],
    "host_permissions": [
        "https://chatgpt.com/*",
        "https://grok.com/*"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
         "matches": [
          "https://chatgpt.com/*",
          "https://grok.com/*"
        ],
        "js": ["content.js"],
        "css": ["sidepanel/sidepanel.css"]
      }
    ],
    "web_accessible_resources": [
      {
        "resources": ["sidepanel/sidepanel.html"],
        "matches": ["https://chatgpt.com/*", "https://grok.com/*"]
      }
    ],
    "action": {
      "default_title": "Toggle EchoNav"
    }
  }
  